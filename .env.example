# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# URL project Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key (aman dipakai di browser; keamanan data dijaga oleh RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL aplikasi (opsional tetapi disarankan di production), tanpa garis miring di akhir.
# Contoh lokal: http://localhost:3000  | Contoh production: https://nama-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# CATATAN: aplikasi ini TIDAK membutuhkan Service Role Key untuk berjalan.
# Jangan pernah menaruh Service Role Key pada variabel berawalan NEXT_PUBLIC_.
