# Hanya untuk test integrasi RLS (tests/rls) dan E2E. Pakai project Supabase KHUSUS TEST, bukan production.
# Salin menjadi .env.test lalu isi. File ini tidak dibaca oleh aplikasi.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
# Service role key hanya dipakai test untuk membuat/menghapus user uji. Jangan dipakai di aplikasi.
TEST_SUPABASE_SERVICE_ROLE_KEY=

# E2E opsional: akun guru yang sudah ada di project test
E2E_EMAIL=
E2E_PASSWORD=
